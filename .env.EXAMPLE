NODE_ENV=development
PORT=3500
BASE_URL=http://localhost:3500
SESSION_KEY=YOUR_SESSION_KEY

# OIDC configuration (any OpenID Connect provider: JumpCloud, Auth0, Okta, Keycloak, Google...)
# Endpoints are auto-discovered from <issuer>/.well-known/openid-configuration
OIDC_ISSUER=https://oauth.id.jumpcloud.com/
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET
OIDC_SCOPE=openid profile email

# Role mapping: emails listed here get the "admin" role (comma separated).
# If your IdP sends a role claim, set OIDC_ROLE_CLAIM to its name instead.
ADMIN_EMAILS=admin@example.com
OIDC_ROLE_CLAIM=

# Optional: Redis session store (recommended in production)
REDIS_URL=
